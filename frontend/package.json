{
  "name": "orbit",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/orbit.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/orbit.css --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "chart.js": "^4.6.1",
    "tailwindcss": "^4.3.5"
  }
}
