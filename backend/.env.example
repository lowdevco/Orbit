# Copy to backend/.env and fill in (read by python-decouple). Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth  (console.cloud.google.com -> APIs & Services -> Credentials)
# Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App  (github.com/settings/developers -> OAuth Apps)
# Callback URL: http://localhost:8000/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database: leave empty for SQLite. For MySQL set DB_ENGINE=mysql and pip install mysqlclient
DB_ENGINE=
DB_NAME=orbit
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

